{
  "name": "lazy-apply",
  "version": "0.1.0",
  "private": true,
  "description": "A local, open-model Chrome extension that fills job applications and never submits.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "wxt build && playwright test",
    "test:e2e:ollama": "wxt build && LAZYAPPLY_E2E_OLLAMA=1 playwright test",
    "mock:model": "node mock-model/server.ts 11435",
    "measure": "wxt build && LAZYAPPLY_E2E_OLLAMA=1 playwright test e2e/measure.spec.ts",
    "fixtures:pdf": "node scripts/make-fixture-pdfs.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "idb": "8.0.4",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.6",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "wxt": "0.21.4"
  }
}
